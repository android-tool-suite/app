{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://android-tool-suite.test/contracts/manifest-v3.schema.json",
  "title": "Android Tool Suite Plugin Manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "plugin", "platforms", "runtime"],
  "properties": {
    "$schema": { "type": "string", "maxLength": 256 },
    "format": { "const": "ats-plugin" },
    "formatVersion": { "const": 3 },
    "plugin": { "$ref": "#/$defs/plugin" },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" }
    },
    "runtime": { "$ref": "#/$defs/runtime" },
    "requires": { "$ref": "#/$defs/requires" },
    "provides": { "$ref": "#/$defs/provides" },
    "contributes": { "$ref": "#/$defs/contributes" },
    "datasets": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/dataset" }
    },
    "tasks": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "entryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "packagePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9._/-]+$"
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "version", "versionCode", "minHostVersionCode", "publisher"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 320 },
        "version": { "$ref": "#/$defs/version" },
        "versionCode": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "minHostVersionCode": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "publisher": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["tool", "trusted-provider"] },
        "homepage": { "type": "string", "format": "uri", "maxLength": 512 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ui"],
      "properties": {
        "ui": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/uiEntry" }
        },
        "background": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/backgroundEntry" }
        },
        "providers": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/providerEntry" }
        }
      }
    },
    "uiEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "entry"],
      "properties": {
        "id": { "$ref": "#/$defs/entryId" },
        "type": { "enum": ["declarative", "web"] },
        "entry": { "$ref": "#/$defs/packagePath" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "web" } } },
          "then": { "properties": { "entry": { "pattern": "^web/(?!.*(?:^|/)\\.{1,2}(?:/|$)).+\\.html$" } } }
        },
        {
          "if": { "properties": { "type": { "const": "declarative" } } },
          "then": { "properties": { "entry": { "pattern": "^ui/(?!.*(?:^|/)\\.{1,2}(?:/|$)).+\\.json$" } } }
        }
      ]
    },
    "backgroundEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "entry", "required"],
      "properties": {
        "id": { "$ref": "#/$defs/entryId" },
        "type": { "enum": ["provider-task", "javascript-worker", "wasm-worker"] },
        "entry": { "$ref": "#/$defs/packagePath" },
        "required": { "type": "boolean" },
        "timeoutMs": { "type": "integer", "minimum": 1000, "maximum": 600000 },
        "maxHeapBytes": { "type": "integer", "minimum": 1048576, "maximum": 268435456 }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "javascript-worker" } } },
          "then": { "properties": { "entry": { "pattern": "^workers/.+\\.js$" } } }
        },
        {
          "if": { "properties": { "type": { "const": "wasm-worker" } } },
          "then": { "properties": { "entry": { "pattern": "^workers/.+\\.wasm$" } } }
        }
      ]
    },
    "providerEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "code", "entryClass", "activation"],
      "properties": {
        "id": { "$ref": "#/$defs/entryId" },
        "type": { "const": "android-dex" },
        "code": { "const": "android/provider.apk" },
        "entryClass": { "type": "string", "minLength": 3, "maxLength": 240, "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(?:\\.[A-Za-z_$][A-Za-z0-9_$]*)+$" },
        "activation": { "const": "cold-start" }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "plugins": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/pluginRequirement" } },
        "capabilities": { "type": "array", "maxItems": 128, "items": { "$ref": "#/$defs/capabilityRequirement" } }
      }
    },
    "pluginRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "optional"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "optional": { "type": "boolean" }
      }
    },
    "capabilityRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "optional"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "optional": { "type": "boolean" },
        "scopes": { "type": "object", "maxProperties": 64 }
      }
    },
    "provides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capabilities": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/capabilityContribution" }
        }
      }
    },
    "capabilityContribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "methods"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "$ref": "#/$defs/version" },
        "providerEntry": { "$ref": "#/$defs/entryId" },
        "workerEntry": { "$ref": "#/$defs/entryId" },
        "methods": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3, "maxLength": 160, "pattern": "^[a-z][A-Za-z0-9]*(?:[._-][A-Za-z0-9]+)+$" }
        }
      },
      "oneOf": [
        { "required": ["providerEntry"], "not": { "required": ["workerEntry"] } },
        { "required": ["workerEntry"], "not": { "required": ["providerEntry"] } }
      ]
    },
    "contributes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "uiEntry"],
            "properties": {
              "id": { "$ref": "#/$defs/entryId" },
              "uiEntry": { "$ref": "#/$defs/entryId" },
              "title": { "type": "string", "minLength": 1, "maxLength": 80 },
              "description": { "type": "string", "minLength": 1, "maxLength": 320 }
            }
          }
        },
        "homeWidgets": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/homeWidget" }
        }
      }
    },
    "homeWidget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "template", "dataSource", "sizes"],
      "properties": {
        "id": { "$ref": "#/$defs/entryId" },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "template": { "enum": ["status", "metric", "action"] },
        "dataSource": { "type": "string", "minLength": 3, "maxLength": 160 },
        "sizes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "enum": ["1x1", "2x1", "2x2", "4x2"] }
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "category", "formatVersion", "sensitive", "restoreModes"],
      "properties": {
        "id": { "$ref": "#/$defs/entryId" },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "category": { "enum": ["settings", "data", "cache", "secret"] },
        "formatVersion": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "sensitive": { "type": "boolean" },
        "mediaType": { "type": "string", "minLength": 3, "maxLength": 128, "pattern": "^[A-Za-z0-9!#$&^_.+-]+/[A-Za-z0-9!#$&^_.+\\-]+$" },
        "validator": { "enum": ["json", "zip", "opaque"] },
        "maxBytes": { "type": "integer", "minimum": 1, "maximum": 536870912 },
        "restoreModes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": { "enum": ["replace", "merge", "skip"] }
        },
        "dependsOn": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/entryId" } }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "backgroundEntry", "triggers", "concurrency", "retry"],
      "properties": {
        "id": { "$ref": "#/$defs/entryId" },
        "backgroundEntry": { "$ref": "#/$defs/entryId" },
        "triggers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/trigger" }
        },
        "constraints": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "network": { "enum": ["none", "connected", "unmetered"] },
            "charging": { "type": "boolean" },
            "batteryNotLow": { "type": "boolean" },
            "storageNotLow": { "type": "boolean" }
          }
        },
        "concurrency": {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy"],
          "properties": {
            "policy": { "enum": ["forbid", "replace", "parallel"] },
            "max": { "type": "integer", "minimum": 1, "maximum": 8 }
          }
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maxAttempts", "initialBackoffMs"],
          "properties": {
            "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 10 },
            "initialBackoffMs": { "type": "integer", "minimum": 10000, "maximum": 86400000 }
          }
        }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["manual", "periodic", "network-available", "charging", "app-foreground", "provider-event"] },
        "intervalMinutes": { "type": "integer", "minimum": 15, "maximum": 525600 },
        "capability": { "$ref": "#/$defs/id" },
        "event": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    }
  }
}
